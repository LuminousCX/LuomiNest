# LuomiNest Docker Environment Example
# Copy this file to .env and update the secrets before running docker compose.

# Application
LUOMINEST_ENV=production
BACKEND_PORT=18000
BACKEND_REPLICAS=1

# PostgreSQL
POSTGRES_USER=luominest
POSTGRES_PASSWORD=ChangeMeInProduction
POSTGRES_DB=luominest
POSTGRES_EXPOSE_PORT=5432

# Redis
REDIS_EXPOSE_PORT=6379

# MQTT
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Optional: external service credentials
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
