{
  "name": "luominest-desktop",
  "version": "0.7.7",
  "description": "LuomiNest 辰汐分布式多用户关系型AI智能体平台 - Electron桌面客户端",
  "author": "LuminousCX R&D Team",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "clean:dist": "node -e \"const fs=require('fs');const p='release/dist';try{fs.rmSync(p,{recursive:true,force:true,maxRetries:5,retryDelay:200});console.log('Cleaned release/dist')}catch(e){if(e.code!=='ENOENT')console.warn('Clean warning:',e.message)}\"",
    "build:win-dir": "pnpm run clean:dist && pnpm run build && electron-builder --win dir",
    "build:linux": "pnpm run build && electron-builder --linux",
    "build:linux-appimage": "pnpm run build && electron-builder --linux AppImage",
    "build:linux-deb": "pnpm run build && electron-builder --linux deb",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:mac-dmg": "pnpm run build && electron-builder --mac dmg",
    "package": "cd .. && pwsh -File build-all.ps1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && vue-tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^7.4.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "cronstrue": "^3.24.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.14",
    "electron-log": "^5.4.4",
    "marked": "^18.0.11",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "pixi-live2d-display-mulmotion": "0.5.0-mm-6",
    "pixi.js": "^7.4.3",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-vue-next": "^1.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vue": "^3.5.32",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.luominest.desktop",
    "productName": "LuomiNest",
    "copyright": "Copyright © 2026 LuminousCX R&D Team",
    "directories": {
      "output": "release/dist"
    },
    "files": [
      "out/**/*",
      "!out/renderer/live2d/**",
      "!out/renderer/pixel/**",
      "!out/renderer/png/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/renderer/public/live2d",
        "to": "live2d",
        "filter": [
          "**/*.moc3",
          "**/*.model3.json",
          "**/*.physics3.json",
          "**/*.pose3.json",
          "**/*.cdi3.json",
          "**/*.exp3.json",
          "**/*.motion3.json",
          "**/*.userdata3.json",
          "**/*.png",
          "**/*.jpg"
        ]
      },
      {
        "from": "src/renderer/public/pixel",
        "to": "pixel",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/renderer/public/png",
        "to": "png",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/models/tts/vits-melo-tts-zh_en",
        "to": "backend/models/tts/vits-melo-tts-zh_en",
        "filter": [
          "**/*",
          "!model.int8.onnx"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": true,
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "resources/icon.svg",
      "maintainer": "LuminousCX R&D Team",
      "vendor": "LuminousCX",
      "synopsis": "LuomiNest - Distributed Multi-user Relational AI Agent Platform",
      "description": "LuomiNest is a distributed multi-user relational AI agent platform that provides personalized conversation, group chat collaboration, IoT control, and Live2D avatar interaction.",
      "artifactName": "LuomiNest-${version}-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "LuomiNest-${version}-linux-${arch}.AppImage"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3"
      ],
      "artifactName": "LuomiNest-${version}-linux-${arch}.deb"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "resources/icon.svg",
      "artifactName": "LuomiNest-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "LuomiNest needs access to your microphone for voice interaction.",
        "NSCameraUsageDescription": "LuomiNest needs access to your camera for visual interaction."
      }
    },
    "dmg": {
      "background": null,
      "backgroundColor": "#fafaf9",
      "window": {
        "x": 400,
        "y": 100,
        "width": 600,
        "height": 500
      },
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "LuomiNest-${version}-mac-${arch}.dmg"
    },
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
