# =============================================================================
# LuomiNest 环境变量示例
# =============================================================================
# 复制本文件为 .env 并按需修改。敏感字段（API Key 等）请勿提交到版本控制。
# 后端 Pydantic Settings 会按以下优先级读取：
#   1. 系统环境变量
#   2. LUOMINEST_AUTH_TOKEN（仅认证令牌）
#   3. .env 文件（工作目录下）
# =============================================================================

# ── 应用核心 ──────────────────────────────────────────────────────────────────
APP_NAME=LuomiNest
# 调试模式：True 时开启 Swagger 文档 (/docs)、返回详细错误信息
DEBUG=False
# 运行环境：development / production
ENVIRONMENT=production

# ── 认证与密钥 ────────────────────────────────────────────────────────────────
# 本地认证令牌（Bearer Token）。留空则自动生成并持久化到 data/config/auth_token
# 多实例部署时需显式指定同一令牌以共享认证
# LUOMINEST_AUTH_TOKEN=
# SECRET_KEY 留空或保持占位符时，首次启动自动生成 Fernet 密钥并持久化到
# data/config/secret_key（用于 AES 加密 API Key 等敏感数据）
# SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 认证模式: local（本地单用户）或 jwt（多用户远程访问）
AUTH_MODE=local
# JWT 密钥（留空则自动生成）
JWT_SECRET_KEY=
# JWT Refresh Token 有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=30
# 是否允许新用户注册
ALLOW_REGISTRATION=true

# 内部服务认证 Token（供可信内部服务调用，留空则禁用内部认证）
INTERNAL_AUTH_TOKEN=
# 是否启用 API 文档（/docs, /redoc），生产环境建议关闭
API_DOCS_ENABLED=false

# ── 数据库与缓存 ──────────────────────────────────────────────────────────────
# 留空时自动使用 SQLite：sqlite+aiosqlite:///<DATA_DIR>/luominest.db
# DATABASE_URL=
# Redis（可选，用于缓存与限流）
REDIS_URL=redis://localhost:6379/0

# ── CORS 跨域 ────────────────────────────────────────────────────────────────
# 允许的前端来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# ── LLM 供应商 ───────────────────────────────────────────────────────────────
LLM_DEFAULT_PROVIDER=openai
LLM_FALLBACK_CHAIN=openai,ollama
LLM_DEFAULT_MODEL=
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=4096
LLM_DEFAULT_TOP_P=0.9
LLM_MAX_CONCURRENT_REQUESTS=3

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Anthropic
ANTHROPIC_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Ollama（本地推理）
OLLAMA_BASE_URL=http://localhost:11434

# ── MQTT 消息总线（可选） ─────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── 数据目录 ──────────────────────────────────────────────────────────────────
# 存储位置按运行模式自动区分（详见 文档/02-系统架构.md（本地工作区，不入库））：
#   · 开发模式（源码运行，IS_FROZEN=False）：默认 backend/data/
#     （Electron dev 模式会把 LUOMINEST_DATA_DIR 注入为 <项目根>/backend/data，
#      与独立后端共用数据目录）
#   · 生产打包（PyInstaller exe，IS_FROZEN=True）：默认 %APPDATA%/LuomiNest/Data/backend/
#     （Electron 注入 LUOMINEST_DATA_DIR = <userData>/Data/backend/，写入用户数据目录，
#      不写安装目录 Program Files）
#   · 纯后端独立运行：默认 ./data（可用 DATA_DIR 覆盖）
# 优先级：LUOMINEST_DATA_DIR（Electron 注入） > DATA_DIR > 运行模式默认值
# 注意：LUOMINEST_DATA_DIR 在 dev 与打包模式都会被 Electron 注入，
#       代码以 sys.frozen 判断"真正的打包模式"，两者不可混用。
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# AVATAR_DIR=./data/avatars
# PLUGIN_DIR=./plugins
# SKILL_DIR=./skills

# 用户数据存储选型（业界常见做法，详见 文档/04-数据模型.md（本地工作区，不入库））：
#   · SQLite 单库（luominest.db）：对话/消息、记忆（画像/事实/摘要/每日记录/知识库）、
#     向量索引（BLOB 行存储）、配置、平台会话 —— 结构化/高频/需事务的数据
#   · JSON 文件（data/store/*.json）：少量可重建缓存与兼容遗留（如插件市场索引缓存），
#     非权威源
#   · 大文件（语音模型/上传/头像/日志）：按类型落盘在 DATA_DIR 下的独立目录

# Live2D / VRM 模型路径
LIVE2D_MODEL_PATH=./models/live2d
VRM_MODEL_PATH=./models/vrm

# ── 文件上传限制 ──────────────────────────────────────────────────────────────
# 单文件最大 100MB
FILE_MAX_SIZE=104857600

# ── TTS 代理（可选） ──────────────────────────────────────────────────────────
TTS_PROXY=

# ── Agent 集群（A2A 协议，可选） ──────────────────────────────────────────────
APP_SELF_BASE_URL=http://localhost:8000
# A2A 服务器列表（JSON 数组）：[{"name":"agent2","url":"http://host:8000","enabled":true,"api_key":""}]
A2A_SERVERS=[]
A2A_TIMEOUT_SECONDS=60
A2A_MAX_DEPTH=3

# ── 可选集成 ──────────────────────────────────────────────────────────────────
# GitHub Token（用于下载 TTS 模型等资源）
GITHUB_TOKEN=
# 外部文件解析 API（可选）
EXTERNAL_PARSE_API_URL=


# ─────────────────────────────────────────────────────────────────────
# 补充字段示例（与 backend/app/core/config.py Settings 对齐，审计 B6-5）
# 以下均为可选：不设置时使用代码内默认值
# ─────────────────────────────────────────────────────────────────────

# 数据库连接（默认由 DATA_DIR 推导 SQLite；示例留空即走默认）
# DATABASE_URL=sqlite+aiosqlite:///./data/luominest.db

# 主密钥（默认自动生成并机器绑定加密存储于 data/config/secret_key，无需手动配置）
# SECRET_KEY=change-me-in-production

# 自动备份
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24

# 上下文压缩与摘要（默认关闭）
LLM_COMPRESS_ENABLED=false
LLM_COMPRESSION_THRESHOLD=0.7
LLM_SUMMARY_MAX_TOKENS=512
LLM_CONTEXT_WINDOW_SIZE=0
LLM_CONTEXT_STRATEGY=truncate
LLM_CONTEXT_BUDGET_RATIO=0.35
LLM_SUMMARY_TARGET_RATIO=0.4
LLM_COMPRESSION_RATIO=40
LLM_ANTI_DRIFT_ENABLED=true

# 目录覆盖（默认随运行模式自动推导，通常无需设置）
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# AVATAR_DIR=./data/avatars
# PLUGIN_DIR=./plugins
# SKILL_DIR=./skills

# 内部状态（由 Electron 主进程注入，桌面端用户无需手动设置）
# IS_FROZEN=false
# DEV_MODE=true
# DATA_DIR_INJECTED=false

# 插件市场发布源（REGISTRY_SOURCES 为复杂 JSON，默认内置 GitHub Raw + jsDelivr，
# 需要自定义 CDN 时参考代码默认值构造）
# REGISTRY_ACTIVE_SOURCE_ID=github-raw
# REGISTRY_REPO_OWNER=luminous-ChenXi
# REGISTRY_REPO_NAME=LuomiNest-cxp-registry
# REGISTRY_INDEX_PATH=index.json
# REGISTRY_BRANCH=main

# 超时类（秒）
TTS_HTTP_TIMEOUT=60
TTS_DOWNLOAD_TIMEOUT=600
TTS_LOCAL_PROC_TIMEOUT=120
MODEL_DOWNLOAD_TIMEOUT=600
PLATFORM_HTTP_TIMEOUT=15

