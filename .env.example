# =============================================================================
# LuomiNest 环境变量示例
# =============================================================================
# 复制本文件为 .env 并按需修改。敏感字段（API Key 等）请勿提交到版本控制。
# 后端 Pydantic Settings 会按以下优先级读取：
#   1. 系统环境变量
#   2. LUOMINEST_AUTH_TOKEN（仅认证令牌）
#   3. .env 文件（工作目录下）
# =============================================================================

# ── 应用核心 ──────────────────────────────────────────────────────────────────
APP_NAME=LuomiNest
# 调试模式：True 时开启 Swagger 文档 (/docs)、返回详细错误信息
DEBUG=False
# 运行环境：development / production
ENVIRONMENT=production

# ── 认证与密钥 ────────────────────────────────────────────────────────────────
# 本地认证令牌（Bearer Token）。留空则自动生成并持久化到 data/config/auth_token
# 多实例部署时需显式指定同一令牌以共享认证
# LUOMINEST_AUTH_TOKEN=
# SECRET_KEY 留空或保持占位符时，首次启动自动生成 Fernet 密钥并持久化到
# data/config/secret_key（用于 AES 加密 API Key 等敏感数据）
# SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 认证模式: local（本地单用户）或 jwt（多用户远程访问）
AUTH_MODE=local
# JWT 密钥（留空则自动生成）
JWT_SECRET_KEY=
# JWT Refresh Token 有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=30
# 是否允许新用户注册
ALLOW_REGISTRATION=true

# 内部服务认证 Token（用于 Java 后端调用，留空则禁用内部认证）
INTERNAL_AUTH_TOKEN=
# 是否启用 API 文档（/docs, /redoc），生产环境建议关闭
API_DOCS_ENABLED=false

# ── 数据库与缓存 ──────────────────────────────────────────────────────────────
# 留空时自动使用 SQLite：sqlite+aiosqlite:///<DATA_DIR>/luominest.db
# DATABASE_URL=
# Redis（可选，用于缓存与限流）
REDIS_URL=redis://localhost:6379/0

# ── CORS 跨域 ────────────────────────────────────────────────────────────────
# 允许的前端来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# ── LLM 供应商 ───────────────────────────────────────────────────────────────
LLM_DEFAULT_PROVIDER=openai
LLM_FALLBACK_CHAIN=openai,ollama
LLM_DEFAULT_MODEL=
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=4096
LLM_DEFAULT_TOP_P=0.9
LLM_MAX_CONCURRENT_REQUESTS=3

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Anthropic
ANTHROPIC_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Ollama（本地推理）
OLLAMA_BASE_URL=http://localhost:11434

# ── MQTT 消息总线（可选） ─────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── 数据目录 ──────────────────────────────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
AVATAR_DIR=./data/avatars
PLUGIN_DIR=./plugins
SKILL_DIR=./skills

# Live2D / VRM 模型路径
LIVE2D_MODEL_PATH=./models/live2d
VRM_MODEL_PATH=./models/vrm

# ── 文件上传限制 ──────────────────────────────────────────────────────────────
# 单文件最大 100MB
FILE_MAX_SIZE=104857600

# ── TTS 代理（可选） ──────────────────────────────────────────────────────────
TTS_PROXY=

# ── Agent 集群（A2A 协议，可选） ──────────────────────────────────────────────
APP_SELF_BASE_URL=http://localhost:8000
# A2A 服务器列表（JSON 数组）：[{"name":"agent2","url":"http://host:8000","enabled":true,"api_key":""}]
A2A_SERVERS=[]
A2A_TIMEOUT_SECONDS=60
A2A_MAX_DEPTH=3

# ── 可选集成 ──────────────────────────────────────────────────────────────────
# GitHub Token（用于下载 TTS 模型等资源）
GITHUB_TOKEN=
# 外部文件解析 API（可选）
EXTERNAL_PARSE_API_URL=
